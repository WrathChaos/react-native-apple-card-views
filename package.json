{
  "name": "react-native-apple-card-views",
  "version": "3.0.0",
  "description": "Fully customizable and perfect clone of Apple, App Store Card Views for React Native",
  "keywords": [
    "bounceable",
    "bouncy",
    "apple",
    "apple-card",
    "card",
    "view",
    "card-view",
    "apple-card-view",
    "react-native",
    "icons",
    "javascript",
    "ui-lib",
    "rn"
  ],
  "homepage": "https://github.com/kuraydev/react-native-apple-card-views#readme",
  "bugs": {
    "url": "https://github.com/kuraydev/react-native-apple-card-views/issues"
  },
  "main": "./build/dist/index.js",
  "module": "./build/dist/index.js",
  "types": "./build/dist/index.d.ts",
  "react-native": "lib/index",
  "source": "lib/index",
  "exports": {
    ".": {
      "types": "./build/dist/index.d.ts",
      "react-native": "./lib/index.ts",
      "default": "./build/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "lib",
    "!**/__tests__",
    "!**/__mocks__",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraydev/react-native-apple-card-views.git"
  },
  "author": "Kuray (FreakyCoder) <kurayogun@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@freakycoder/react-native-bounceable": ">=1.0.0",
    "react": ">=17.0.0",
    "react-native": ">=0.64.0"
  },
  "peerDependenciesMeta": {
    "@freakycoder/react-native-bounceable": {
      "optional": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.4.1",
    "@eslint/js": "^9.2.0",
    "@freakycoder/react-native-bounceable": "^1.0.3",
    "@react-native/babel-preset": "^0.74.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "react": "18.3.1",
    "react-native": "0.74.5",
    "react-test-renderer": "18.3.1",
    "semantic-release": "^24.0.0",
    "typescript": "^5.0.2",
    "typescript-eslint": "^7.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepare": "husky || true",
    "format": "prettier --write \"lib/**/*.{ts,tsx}\"",
    "lint": "eslint lib",
    "lint:fix": "eslint lib --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "semantic-release": "semantic-release"
  }
}
